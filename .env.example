# Used by docker-compose.yml when running the full stack via `docker compose up`.
# Copy to .env and fill in before running.

OPENROUTER_API_KEY=
LOG_LEVEL=INFO

# email-ingest (bank alert emails -> email_transactions). Use a Gmail app password
# dedicated to this job so it can be revoked independently.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EXTRACT_MODEL=google/gemini-2.5-flash

# NocoDB admin login (http://localhost:8505, Tailscale-only)
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=
