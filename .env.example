# Used by docker-compose.yml when running the full stack via `docker compose up`.
# Copy to .env and fill in before running.

OPENROUTER_API_KEY=
LOG_LEVEL=INFO

# pgAdmin login (http://localhost:8504, Tailscale-only)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# NocoDB admin login (http://localhost:8505, Tailscale-only)
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=
