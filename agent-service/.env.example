GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_service

HOST=0.0.0.0
PORT=8000
RELOAD=false

SUMMARIZATION_KEEP_MESSAGES=20

# Points at backend-service's MCP endpoint. mcp_servers.json (docker-network hostname)
# is used inside docker-compose; for a local (non-docker) run, point this at
# mcp_servers.local.json instead, which uses http://localhost:8502/mcp.
MCP_CONFIG_PATH=mcp_servers.json
