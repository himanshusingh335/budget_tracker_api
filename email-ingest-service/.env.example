# For local runs of src/ingest.py (docker-compose reads the root .env instead).
GMAIL_USER=
# A Gmail app password dedicated to this job — revoke it independently of any other mail client.
GMAIL_APP_PASSWORD=
OPENROUTER_API_KEY=
EXTRACT_MODEL=google/gemini-2.5-flash
BACKEND_URL=http://localhost:8502
LOOKBACK_DAYS=2
